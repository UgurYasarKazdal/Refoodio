<?xml version="1.0" encoding="utf-8"?>
<!--
    Refoodio uygulama ikonu — viewport: 108×108
    Safe zone: 18–90 (adaptive icon)
    Tasarım: 3 dişli çatal (sol-orta) + almond yaprağı (sağ)
    Tüm yollar beyaz (#FFFFFF) — arka plan background layer tarafından sağlanır
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!--
        Çatal + yaprak bileşik yolu.

        Çatal anatomisi:
          Sol diş  : x=33–38, y=26.5–44  (yuvarlak üst, r=2.5)
          Orta diş : x=43–48, y=26.5–44
          Sağ diş  : x=53–58, y=26.5–44
          Omuz     : x=33–58 → x=39–52, y=44–50  (trapez daralma)
          Sap      : x=39–52, y=50–80  (yuvarlak alt)

        Yaprak     : almond/badem formu, tepe (74,24) → dip (74,52)
    -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="
            M33,44 L33,26.5 A2.5,2.5 0 0 0 38,26.5 L38,44 Z
            M43,44 L43,26.5 A2.5,2.5 0 0 0 48,26.5 L48,44 Z
            M53,44 L53,26.5 A2.5,2.5 0 0 0 58,26.5 L58,44 Z
            M33,44 L58,44 L52,50 L39,50 Z
            M39,50 L52,50 L52,80 A6.5,5 0 0 1 39,80 Z
            M74,24 C81,28 83,38 74,52 C65,38 67,28 74,24 Z
        " />

</vector>
